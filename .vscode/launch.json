{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Electron Main",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-forge",
      "runtimeArgs": [
        "start",
        "--inspect-electron",
        "--",
        "--disable-gpu",
        "--disable-software-rasterizer",
        "--no-sandbox"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DISPLAY": ":0",
        "AICHAT_DEBUG_REQUEST": "0",
        "CHOKIDAR_USEPOLLING": "1",
        "CHOKIDAR_INTERVAL": "1000",
        "AIFETCHLY_DEV_BROWSER_BRIDGE": "1",
        "AIFETCHLY_DEV_BROWSER_BRIDGE_HOST": "127.0.0.1",
        "AIFETCHLY_DEV_BROWSER_BRIDGE_PORT": "37621",
        "AIFETCHLY_DEV_BROWSER_BRIDGE_ALLOWED_ORIGIN": "http://localhost:5173"
      },
      "outFiles": [
        "${workspaceFolder}/.vite/build/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest Debug Current Test File",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v22.19.0/bin/node",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome Renderer (Dev Browser)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/views",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Electron + Chrome (Dev Browser)",
      "configurations": ["Electron Main", "Chrome Renderer (Dev Browser)"]
    }
  ]
}
