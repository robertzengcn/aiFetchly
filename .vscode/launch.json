{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Electron Main",
      "address": "127.0.0.1",
      "port": 9229,
      "preLaunchTask": "electron-forge-start-debug",
      "cwd": "${workspaceFolder}",
      "outFiles": [
        "${workspaceFolder}/.vite/build/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "restart": true,
      "timeout": 60000,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest Debug Current Test File",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v22.19.0/bin/node",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome Renderer (Dev Browser)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/views",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Electron + Chrome (Dev Browser)",
      "configurations": ["Electron Main", "Chrome Renderer (Dev Browser)"]
    }
  ]
}
