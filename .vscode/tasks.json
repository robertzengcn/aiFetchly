{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
      {
        "label": "electron-forge-start-debug",
        "type": "process",
        "command": "${workspaceFolder}/node_modules/.bin/electron-forge",
        "windows": {
          "command": "${workspaceFolder}/node_modules/.bin/electron-forge.cmd"
        },
        "args": [
          "start",
          "--inspect-electron",
          "--",
          "--disable-gpu",
          "--disable-software-rasterizer",
          "--no-sandbox"
        ],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "NODE_OPTIONS": "",
            "VSCODE_INSPECTOR_OPTIONS": "",
            "PATH": "${env:HOME}/.nvm/versions/node/v22.19.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${env:PATH}",
            "AIFETCHLY_SKIP_VITE_CHECKER": "1",
            "DISPLAY": ":0",
            "AICHAT_DEBUG_REQUEST": "0",
            "CHOKIDAR_USEPOLLING": "1",
            "CHOKIDAR_INTERVAL": "1000",
            "AIFETCHLY_DEV_BROWSER_BRIDGE": "1",
            "AIFETCHLY_DEV_BROWSER_BRIDGE_HOST": "127.0.0.1",
            "AIFETCHLY_DEV_BROWSER_BRIDGE_PORT": "37621",
            "AIFETCHLY_DEV_BROWSER_BRIDGE_ALLOWED_ORIGIN": "http://localhost:5173"
          }
        },
        "isBackground": true,
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "problemMatcher": {
          "owner": "electron-forge",
          "pattern": {
            "regexp": "^$"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Launched Electron app"
          }
        }
      }
    ]
  }
